# ---- Server ----
NODE_ENV=development
PORT=4000
# Number of proxies in front of the API. Keep 1 on Render (its load balancer appends the real IP).
# Visitors coming through the website are identified by x-client-ip + PROXY_SECRET instead.
TRUST_PROXY=1

# ---- Database ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-64-char-random-string
JWT_EXPIRES_IN=1d
COOKIE_NAME=pf_session

# Used only by `npm run seed` to create the single admin account
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-unique-password

# ---- Frontend ----
# Comma-separated list of origins allowed by CORS
CLIENT_ORIGINS=http://localhost:3000
# Where the Next.js app lives; the API calls CLIENT_URL/api/revalidate after admin edits
CLIENT_URL=http://localhost:3000
# Must match REVALIDATE_SECRET in client/.env.local (32+ chars in production)
REVALIDATE_SECRET=replace-with-another-random-string

# ---- Cloudinary (uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# ---- Email notifications (Resend) ----
# Leave RESEND_API_KEY empty in development to log emails to the console instead
RESEND_API_KEY=
MAIL_FROM=Portfolio <noreply@bishwabandhu.me>
CONTACT_NOTIFY_EMAIL=bishwabandhuparmar06@gmail.com

# Salt for hashing contact-form IP addresses (never stored in plain text). 32+ chars in production.
IP_HASH_SALT=replace-with-a-random-string

# Shared with client/.env.local. The website's proxy sends it with the visitor's IP, so rate limits
# apply per visitor instead of per Vercel server, while spoofed headers on direct requests are ignored.
PROXY_SECRET=replace-with-another-random-string
