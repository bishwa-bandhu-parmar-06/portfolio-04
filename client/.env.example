# Base URL of the Express API (no trailing slash). Used server-side for data fetching
# and as the target of the /api/* rewrite, so the browser only ever talks to this site.
API_URL=http://localhost:4000

# Public URL of this site (used for metadata, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with the server's REVALIDATE_SECRET; lets the API refresh cached pages after admin edits
REVALIDATE_SECRET=replace-with-another-random-string

# Same value as the server's JWT_SECRET. Lets proxy.ts check the admin session cookie
# before sending any /admin page (the API still verifies every request itself).
JWT_SECRET=replace-with-the-same-secret-as-the-server
